---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Gallery from '../../../features/gallery/Gallery.astro';
import { siteContent, tripPhotos } from '../../../lib/content';
export async function getStaticPaths(){const {trips}=await siteContent();return trips.map(trip=>({params:{tripId:trip.id},props:{trip}}));}
const {trip}=Astro.props;
const photos=tripPhotos(trip.id);
---
<SiteLayout title={`${trip.data.title}的相册`} active="photos"><div class="wrap"><div class="breadcrumb"><a href="/photos/">相册</a><span aria-hidden="true">/</span><a href={`/trips/${trip.id}/`}>{trip.data.title}</a></div><header class="page-head"><div><p class="eyebrow">旅途里的光，与当时的心情。</p><h1>{trip.data.title}<span class="accent"> · 相册</span></h1></div><nav class="album-links" aria-label="相册导航"><a class="section-link" href="/photos/">全部旅行相册</a><a class="section-link" href={`/trips/${trip.id}/`}>回到旅行{trip.data.status==='planning'?'计划':'记录'}</a></nav></header><Gallery photos={photos}/></div></SiteLayout>
<style>.page-head h1{text-wrap:balance}.album-links{display:flex;flex-wrap:wrap;gap:16px 24px;flex-shrink:0}@media(max-width:760px){.album-links{margin-top:20px}}</style>
