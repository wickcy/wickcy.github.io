---
import './plan.css';
interface Props { plan: Record<string, any>; tripId?: string }
const { plan, tripId } = Astro.props;
const { markup, ...interactiveData } = plan;
const serialized = JSON.stringify({ ...interactiveData, id: tripId || interactiveData.id }).replace(/</g, '\\u003c');
---
<link rel="stylesheet" href="/vendor/leaflet.css" />
<div class="plan-experience" data-plan-experience>
  <Fragment set:html={markup} />
  <noscript><p class="wrap">请启用 JavaScript 使用行程切换、预算和地图；目的地比较、景点与准备说明仍可直接阅读。</p></noscript>
  <script type="application/json" data-plan-data set:html={serialized} />
</div>
<script is:inline src="/vendor/leaflet.js"></script>
<script>
  import { initPlans } from './plan-client.js';
  initPlans();
</script>
