---
interface Photo {
  id: string;
  src: string;
  thumbnail?: string;
  preview?: string;
  alt: string;
  caption?: string;
  cityId?: string;
  width?: number;
  height?: number;
}

interface Props {
  photos: Photo[];
  title?: string;
  description?: string;
}

const {
  photos,
  title = '沿途的每一张',
  description = '点击照片放大，慢慢翻看这一路。',
} = Astro.props;
---

<section class="travel-gallery" data-travel-gallery>
  <header class="gallery-heading">
    <div class="gallery-title"><h2>{title}</h2>{photos.length > 0 && <span>{photos.length} 张照片</span>}</div>
    <p>{photos.length ? description : '照片会在旅途中慢慢积攒，回来后再把记忆放进这里。'}</p>
  </header>

  {photos.length === 0 ? (
    <div class="gallery-empty">
      <span class="empty-frame" aria-hidden="true"><span></span></span>
      <h3>这一页，留给未来的照片。</h3>
      <p>目前还没有公开的旅行照片。</p>
    </div>
  ) : (
    <>
      <div class="photo-wall">
        {photos.map((photo, index) => (
          <figure class="photo-card" style={`--photo-ratio: ${photo.width && photo.height ? `${photo.width} / ${photo.height}` : '3 / 2'}`}>
            <a
              href={photo.src}
              data-gallery-photo
              data-gallery-index={index}
              data-photo-src={photo.preview || photo.src}
              data-photo-original={photo.src}
              data-photo-alt={photo.alt}
              data-photo-caption={photo.caption || photo.alt}
              aria-label={`查看照片 ${index + 1}：${photo.alt}`}
            >
              <span class="photo-frame" data-photo-frame>
                <img src={photo.thumbnail || photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
                <span class="image-error" hidden>照片暂时无法加载</span>
              </span>
            </a>
            <figcaption class="photo-caption"><span>{photo.caption || photo.alt}</span></figcaption>
          </figure>
        ))}
      </div>

      <dialog class="photo-viewer" aria-label="旅行照片查看器" data-gallery-viewer>
        <header class="viewer-heading">
          <h3 data-viewer-heading>旅行照片</h3>
          <button type="button" class="viewer-close" data-viewer-close aria-label="关闭照片查看器" autofocus>关闭 <span aria-hidden="true">×</span></button>
        </header>
        <div class="viewer-stage">
          <p class="viewer-message" data-viewer-loading>正在加载照片…</p>
          <img data-viewer-image alt="" hidden />
          <p class="viewer-message" data-viewer-error hidden>这张照片暂时无法加载，可以继续浏览其他照片。</p>
        </div>
        <footer class="viewer-controls">
          <button type="button" data-viewer-previous aria-label="上一张照片"><span aria-hidden="true">←</span> 上一张</button>
          <p data-viewer-status aria-live="polite" aria-atomic="true"></p>
          <button type="button" data-viewer-next aria-label="下一张照片">下一张 <span aria-hidden="true">→</span></button>
        </footer>
        <p class="viewer-hint"><a data-viewer-original target="_blank" rel="noopener">打开完整尺寸 ↗</a><br />可使用键盘左右方向键切换，Esc 关闭。</p>
      </dialog>
    </>
  )}
</section>

<script>
  import './gallery.mjs';
</script>

<style>
  .travel-gallery { padding-block: 12px 48px; }
  .gallery-heading { margin-bottom: 24px; }
  .gallery-title { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 10px; }
  .gallery-title h2 { margin: 0; font: 500 clamp(27px, 3vw, 35px)/1.5 var(--serif); }
  .gallery-title > span { color: var(--muted); font-size: 12px; white-space: nowrap; }
  .gallery-heading p { margin: 0; max-width: 660px; color: var(--muted); font-size: 14px; line-height: 1.9; }
  .photo-wall { column-count: 3; column-gap: 0; }
  .photo-card { position: relative; width: 100%; min-width: 0; margin: 0; break-inside: avoid; aspect-ratio: var(--photo-ratio); content-visibility: auto; contain-intrinsic-size: auto none; }
  .photo-card a { display: block; position: relative; }
  .photo-frame { position: relative; display: block; overflow: hidden; background: var(--light); aspect-ratio: var(--photo-ratio); }
  .photo-frame img { width: 100%; height: 100%; object-fit: contain; transition: transform .5s ease; }
  .photo-card a:hover img { transform: scale(1.025); }
  .photo-card a:focus-visible { outline-offset: -4px; z-index: 1; }
  .photo-caption { position: absolute; inset: auto 0 0; margin: 0; padding: 10px 12px; color: #fff; background: rgb(0 0 0 / 65%); font-size: 14px; line-height: 1.65; overflow-wrap: anywhere; pointer-events: none; }
  .photo-caption > span { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
  .image-error { position: absolute; inset: 0; display: grid; place-items: center; padding: 24px; font-size: 14px; line-height: 1.8; color: var(--muted); text-align: center; }
  [hidden] { display: none !important; }
  .gallery-empty { display: grid; justify-items: center; padding: 56px 24px; border: 1px dashed var(--line); border-radius: 4px; text-align: center; }
  .gallery-empty h3 { margin: 22px 0 8px; font: 500 23px/1.7 var(--serif); }
  .gallery-empty p { margin: 0; font-size: 14px; color: var(--muted); }
  .empty-frame { width: 62px; height: 49px; display: grid; place-items: center; padding: 8px; border: 1px solid #9aa79a; transform: rotate(-4deg); }
  .empty-frame > span { width: 100%; height: 100%; border: 1px solid var(--line); }
  .photo-viewer { width: min(1100px, calc(100vw - 32px)); height: min(860px, calc(100dvh - 32px)); max-width: none; max-height: none; padding: 24px; border: 1px solid var(--line); border-radius: 4px; background: var(--paper); color: var(--ink); overscroll-behavior: contain; }
  .photo-viewer[open] { display: grid; grid-template-rows: auto minmax(0, 1fr) auto auto; gap: 18px; }
  .photo-viewer::backdrop { background: #14251dd9; }
  .viewer-heading { display: flex; align-items: start; justify-content: space-between; gap: 24px; }
  .viewer-heading h3 { margin: 0; max-height: 3.4em; overflow: auto; font: 500 19px/1.7 var(--serif); overflow-wrap: anywhere; }
  .viewer-close, .viewer-controls button { flex-shrink: 0; min-height: 44px; padding: 8px 14px; background: transparent; border: 1px solid var(--line); border-radius: 3px; color: var(--green); font: inherit; font-size: 14px; cursor: pointer; }
  .viewer-close { margin-top: -5px; }
  .viewer-close > span { margin-left: 10px; font-size: 20px; line-height: 1; }
  .viewer-stage { display: grid; place-items: center; min-width: 0; min-height: 0; overflow: hidden; background: var(--light); }
  .viewer-stage img { display: block; width: 100%; height: 100%; min-width: 0; min-height: 0; max-height: 100%; object-fit: contain; }
  .viewer-message { margin: 0; padding: 40px 24px; color: var(--muted); font-size: 14px; text-align: center; }
  .viewer-controls { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 14px; }
  .viewer-controls button:first-child { justify-self: start; }
  .viewer-controls button:last-child { justify-self: end; }
  .viewer-controls button:disabled { opacity: .45; cursor: default; }
  .viewer-controls p { margin: 0; color: var(--muted); font: 16px/1.6 Georgia, serif; }
  .viewer-hint { margin: -6px 0 0; text-align: center; color: var(--muted); font-size: 12px; }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--orange); outline-offset: 4px; }
  @media (max-width: 760px) {
    .gallery-heading { margin-bottom: 24px; }
    .photo-wall { column-count: 2; }
    .photo-caption { padding: 7px 9px; font-size: 12px; }
    .photo-viewer { width: calc(100vw - 20px); height: calc(100dvh - 20px); padding: 16px; }
    .photo-viewer[open] { gap: 14px; }
    .viewer-heading { gap: 12px; }
    .viewer-heading h3 { font-size: 17px; }
    .viewer-close { padding: 8px 10px; }
    .viewer-controls { gap: 8px; }
    .viewer-controls button { padding: 8px 10px; font-size: 13px; }
    .viewer-hint { font-size: 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .photo-frame img { transition: none; } }
</style>
